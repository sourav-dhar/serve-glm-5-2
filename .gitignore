loadtest/report/*.json
loadtest/report/*.jsonl
loadtest/report/*.png
harness/report/
report/

# Rendered figures larger than source (keep the .md scenes, not the pngs, unless curated)
docs/figures/*.png

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
